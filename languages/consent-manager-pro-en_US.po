msgstr "Only addresses on the site’s domain (with or without www, plus subdomains). You can also enter just the path, for example /contact/."

#: includes/admin/class-check-page.php:269
msgid "Salvează lista"
msgstr "Save list"

#: includes/admin/class-check-page.php:273
msgid "Scanarea pe server"
msgstr "Server scan"

