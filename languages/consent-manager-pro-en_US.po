msgid_plural "%1$d pagini, acum %2$s"
msgstr[0] "%1$d page, %2$s ago"
msgstr[1] "%1$d pages, %2$s ago"

#: includes/admin/class-check-page.php:280
#: includes/admin/class-services-page.php:217
msgid "Rescanează"
msgstr "Rescan"

#: includes/admin/class-check-page.php:287
msgid "Serverul citește HTML-ul paginilor, ca un vizitator fără cookie-uri. Vede ce e în pagină, nu ce adaugă JavaScript-ul ulterior."
msgstr "The server reads the pages’ HTML, like a visitor without cookies. It sees what is in the page, not what JavaScript adds later."

#: includes/admin/class-check-page.php:289
#: includes/admin/class-services-page.php:220
msgid "Scanăm paginile site-ului în fundal. Reîncarcă pagina mai târziu."
msgstr "Scanning the site’s pages in the background. Reload this page later."

#: includes/admin/class-check-page.php:289
msgid "Nicio pagină scanată încă. Apasă „Rescanează”."
msgstr "No pages scanned yet. Click “Rescan”."

#: includes/admin/class-check-page.php:293
#: includes/admin/class-check-page.php:409
#: includes/admin/class-legal-page.php:345
msgid "Pagina"
msgstr "Page"

#: includes/admin/class-check-page.php:294
msgid "Servicii și sursa lor"
msgstr "Services and their source"

#: includes/admin/class-check-page.php:295
msgid "Resurse care trimit IP-ul"
msgstr "Resources that send the IP address"

#. translators: %s: HTTP code or "error"
#: includes/admin/class-check-page.php:303
#, php-format
msgid "nu s-a putut citi (%s)"
msgstr "could not be read (%s)"

#: includes/admin/class-check-page.php:305
msgid "ultima citire a eșuat; se arată rezultatul anterior"
msgstr "the last read failed; showing the previous result"

#: includes/admin/class-check-page.php:313
msgid "niciun serviciu"
msgstr "no services"

#: includes/admin/class-check-page.php:330
msgid "niciuna"
msgstr "none"

#: includes/admin/class-check-page.php:353
msgid "Google Fonts trimite IP-ul vizitatorului la Google. Fonturile se pot servi de pe site, adunate din toate paginile scanate."
msgstr "Google Fonts sends the visitor’s IP address to Google. The fonts can be served from your site, collected from all scanned pages."

#: includes/admin/class-check-page.php:359
msgid "Localizează"
msgstr "Localize"

#: includes/admin/class-check-page.php:362
msgid "Pornește întâi „Localizare Google Fonts” în Setări (doar în modul Pro), apoi revino aici."
msgstr "First turn on “Localize Google Fonts” in Settings (Pro mode only), then come back here."

#: includes/admin/class-check-page.php:367
msgid "Adobe Fonts, Font Awesome și CDN-urile (jsDelivr, unpkg, cdnjs) trimit și ele IP-ul vizitatorului la un terț. Le poți găzdui pe site ca să nu mai fie nevoie de ele."
msgstr "Adobe Fonts, Font Awesome and CDNs (jsDelivr, unpkg, cdnjs) also send the visitor’s IP address to a third party. You can host these files on your site so they are no longer needed."

#: includes/admin/class-check-page.php:369
msgid "Verificare în browser"
msgstr "Browser check"

#: includes/admin/class-check-page.php:371
msgid "Modul Light nu cere acord: verificarea măsoară doar ce se încarcă înainte de acord."
msgstr "Light mode does not ask for consent: the check only measures what loads before consent."

#: includes/admin/class-check-page.php:373
msgid "Blocarea scripturilor e oprită: serviciile se încarcă fără acord"
msgstr "Script blocking is off: services load without consent"

#: includes/admin/class-check-page.php:375
msgid "Încarcă pe rând, invizibil, paginile de mai sus și notează ce se încarcă înainte de acord și ce apare în plus după un „Acceptă tot” simulat."
msgstr "Loads the pages above one at a time, invisibly, and records what loads before consent and what is added after a simulated “Accept all”."

#: includes/admin/class-check-page.php:377
msgid "Limitele verificării"
msgstr "Limits of the check"

#: includes/admin/class-check-page.php:379
msgid "Rulează în browserul tău, ca administrator logat. Pluginurile care schimbă pagina pentru utilizatorii logați pot da alt rezultat decât pentru vizitatori."
msgstr "It runs in your browser, as a logged-in administrator. Plugins that change the page for logged-in users may give a different result than for visitors."

#: includes/admin/class-check-page.php:380
msgid "Paginile care nu permit încărcarea într-un cadru (X-Frame-Options sau CSP frame-ancestors) nu pot fi verificate: rândul lor apare „nu s-a putut verifica”, nu verde."
msgstr "Pages that do not allow loading in a frame (X-Frame-Options or CSP frame-ancestors) cannot be checked: their row shows “could not be checked”, not green."

#: includes/admin/class-check-page.php:381
msgid "Cookie-urile puse de terți pe domeniile lor nu pot fi citite; se văd doar domeniile contactate."
msgstr "Cookies set by third parties on their own domains cannot be read; only the contacted domains are visible."

#: includes/admin/class-check-page.php:382
msgid "Cookie-urile care erau deja în browserul tău înainte de verificare (de la un acord real sau de la o verificare anterioară) sunt arătate separat și nu schimbă rezultatul: pentru ele contează domeniile contactate. Pentru o verificare completă a cookie-urilor, folosește o fereastră privată în care te autentifici."
msgstr "Cookies that were already in your browser before the check (from a real consent or an earlier check) are shown separately and do not change the result: for them, the contacted domains are what counts. For a full cookie check, use a private window and log in there."

#: includes/admin/class-check-page.php:383
msgid "Se pot verifica doar paginile cu aceeași origine ca adminul (același www și http/https). Paginile de pe subdomenii apar „nu s-a putut verifica”."
msgstr "Only pages with the same origin as the admin (same www and http/https) can be checked. Pages on subdomains show “could not be checked”."

#: includes/admin/class-check-page.php:384
msgid "Ce apare doar după interacțiune (clic, scroll) nu e prins."
msgstr "Anything that appears only after interaction (click, scroll) is not caught."

#: includes/admin/class-check-page.php:386
msgid "„Acceptă tot” se apasă în browserul tău. Acordul tău real nu se schimbă, dar cookie-urile puse de servicii (de exemplu _ga) rămân în browser după verificare, chiar dacă alegerea ta e „refuz”."
msgstr "“Accept all” is clicked in your browser. Your real consent does not change, but cookies set by services (for example _ga) stay in your browser after the check, even if your choice is “reject”."

#: includes/admin/class-check-page.php:387
msgid "După acord, fiecare pagină verificată poate apărea ca o vizită în statisticile tale (Google Analytics și altele)."
msgstr "After consent, each checked page may show up as a visit in your analytics (Google Analytics and others)."

#: includes/admin/class-check-page.php:392
msgid "Verifică în browser"
msgstr "Check in browser"

#: includes/admin/class-check-page.php:398
msgid "Raport"
msgstr "Report"

#. translators: %s: time span
#: includes/admin/class-check-page.php:400
#, php-format
msgid "acum %s"
msgstr "%s ago"

